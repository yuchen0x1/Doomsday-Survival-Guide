{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": "../..",
    "baseUrl": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@apocalypse/core": ["../../packages/core/src/index.ts"],
      "@apocalypse/knowledge-data": ["../../packages/knowledge-data/src/index.ts"]
    }
  },
  "include": ["src/**/*", "prisma/**/*", "test/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
