{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APOCALYPSE SURVIVAL",
  "version": "1.1.1",
  "identifier": "local.survival.apocalypse",
  "build": {
    "beforeDevCommand": "pnpm --filter @apocalypse/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node ../../scripts/build-native-web.cjs",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "APOCALYPSE SURVIVAL",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "tooltip": "APOCALYPSE SURVIVAL · 末日生存",
      "iconPath": "icons/icon.png",
      "menuOnLeftClick": true
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
