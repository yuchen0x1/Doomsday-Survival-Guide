{
  "name": "apocalypse-survival",
  "version": "1.0.0",
  "private": true,
  "description": "APOCALYPSE SURVIVAL - 末日生存指南：跨平台末日生存百科全书",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @apocalypse/web dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @apocalypse/web build",
    "build:api": "pnpm --filter @apocalypse/api build",
    "build:desktop": "pnpm --filter @apocalypse/desktop build",
    "build:mobile": "pnpm --filter @apocalypse/mobile build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "api:start": "pnpm --filter @apocalypse/api start",
    "api:start:dev": "pnpm --filter @apocalypse/api start:dev",
    "db:migrate": "pnpm --filter @apocalypse/api prisma:migrate",
    "db:seed": "pnpm --filter @apocalypse/api prisma:seed",
    "db:studio": "pnpm --filter @apocalypse/api prisma:studio"
  }
}
