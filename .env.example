# =============================================================
# APOCALYPSE SURVIVAL 环境变量示例
# 复制为 .env 后填写。严禁将真实密钥提交到仓库。
# =============================================================

# ---------- 服务端（apps/api） ----------
# 服务监听端口
API_PORT=3000
# 运行环境
NODE_ENV=development

# ---------- 数据库 ----------
# PostgreSQL 连接（Docker Compose 默认值）
DATABASE_URL=postgresql://survival:survival@localhost:5432/apocalypse_survival
# SQLite（桌面端本地库 / 开发回退）
SQLITE_PATH=./data/local.db

# ---------- 认证 ----------
# JWT 签名密钥（生产环境必须替换为强随机值，至少 32 字节）
JWT_SECRET=change-me-to-a-strong-random-secret-32bytes
JWT_EXPIRES_IN=7d
# 首次启动创建的管理员账号（仅用于初始化种子）
ADMIN_EMAIL=admin@survival.local
ADMIN_PASSWORD=change-me-initial-admin-password

# ---------- AI 服务（MiMo-V2.6-Flash，OpenAI 兼容） ----------
# 密钥仅保存在服务端，严禁打包进 Web / 桌面 / 移动端
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2.6-Flash
AI_API_KEY=
# 流式请求超时（毫秒）
AI_TIMEOUT_MS=60000
# 每分钟每 IP AI 请求上限
AI_RATE_LIMIT_PER_MIN=20

# ---------- 存储 ----------
# S3 兼容对象存储（可选，用于图片与离线包托管）
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---------- 地图服务（可配置替换） ----------
# 支持任意 OSM 兼容瓦片服务；国内可替换为合规服务商
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors

# ---------- 限流与安全 ----------
# 全局 API 每分钟请求数（每 IP）
API_RATE_LIMIT_PER_MIN=300
# 文件上传限制（字节），默认 5MB
UPLOAD_MAX_BYTES=5242880
# 是否启用 CORS 白名单（生产环境 true）
ENABLE_CORS_WHITELIST=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
